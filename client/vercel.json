{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "node .yarn/releases/yarn-4.18.1.cjs install --immutable",
  "buildCommand": "node .yarn/releases/yarn-4.18.1.cjs build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
